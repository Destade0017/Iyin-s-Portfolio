---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import { projects } from '../data/projects';
import { experiences } from '../data/experience';

const primaryExperiences = experiences.filter(e => !e.isSecondary);
const secondaryExperiences = experiences.filter(e => e.isSecondary);
---

<Layout 
  title="Ajayi Enitan Fiyinfoluwa | Frontend Developer & Web Developer"
  description="Ajayi Enitan Fiyinfoluwa is a Frontend Developer and Web Developer based in Lagos, Nigeria specializing in responsive web applications, React, PHP backends, and modern UI engineering."
>
  <!-- Hero Section with Portrait, Bio, CTAs & Tech Badges -->
  <Hero />

  <!-- Services & Capabilities Section -->
  <Services />

  <!-- Selected Projects Section with Interactive Filtering -->
  <section id="projects" class="py-16 sm:py-24 space-y-10 border-b border-[var(--color-border)]">
    <div class="max-w-2xl space-y-3">
      <div class="text-label text-[var(--color-accent-text)] font-mono tracking-widest">
        SELECTED WORK
      </div>
      <h2 class="text-h1 font-bold text-[var(--color-text-primary)] tracking-tight">
        Featured &amp; Built Projects
      </h2>
      <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
        A selection of responsive React web applications, dynamic PHP/MySQL platforms, and REST API integrations built with high standards of usability, speed, and clean code.
      </p>
    </div>

    <!-- Interactive Technology Filter Tabs (Item #2 Improvement) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2 pb-2 border-b border-[var(--color-border)]/60">
      <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Filter projects by technology">
        <button 
          type="button" 
          data-filter="all" 
          class="project-filter-btn active inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono font-medium border border-[var(--color-accent)] bg-[var(--color-accent)] text-white shadow-xs transition-all cursor-pointer"
          aria-selected="true"
        >
          <span>All</span>
          <span class="opacity-80">({projects.length})</span>
        </button>
        <button 
          type="button" 
          data-filter="react" 
          class="project-filter-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono font-medium border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-text-secondary)] transition-all cursor-pointer"
          aria-selected="false"
        >
          <span>React.js</span>
          <span class="opacity-80">(3)</span>
        </button>
        <button 
          type="button" 
          data-filter="php" 
          class="project-filter-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono font-medium border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-text-secondary)] transition-all cursor-pointer"
          aria-selected="false"
        >
          <span>PHP &amp; MySQL</span>
          <span class="opacity-80">(2)</span>
        </button>
        <button 
          type="button" 
          data-filter="api" 
          class="project-filter-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono font-medium border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-text-secondary)] transition-all cursor-pointer"
          aria-selected="false"
        >
          <span>REST APIs</span>
          <span class="opacity-80">(3)</span>
        </button>
        <button 
          type="button" 
          data-filter="bootstrap" 
          class="project-filter-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono font-medium border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-text-secondary)] transition-all cursor-pointer"
          aria-selected="false"
        >
          <span>Bootstrap</span>
          <span class="opacity-80">(3)</span>
        </button>
      </div>

      <!-- Live Filter Status Counter -->
      <div id="filter-status" class="text-xs font-mono text-[var(--color-text-secondary)]" aria-live="polite">
        Showing all <span class="font-bold text-[var(--color-text-primary)]">{projects.length}</span> projects
      </div>
    </div>

    <!-- Unified Filterable Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {projects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>

    <!-- Empty State Notification -->
    <div id="no-projects-msg" class="hidden py-12 text-center border border-dashed border-[var(--color-border)] rounded-[var(--radius-md)] p-8">
      <p class="text-body text-[var(--color-text-secondary)] font-mono">No projects found matching this technology filter.</p>
    </div>
  </section>

  <!-- Skills & Technologies Section -->
  <Skills />

  <!-- Experience Section -->
  <section id="experience" class="py-16 sm:py-24 space-y-12 border-b border-[var(--color-border)]">
    <div class="max-w-2xl space-y-3">
      <div class="text-label text-[var(--color-accent-text)] font-mono tracking-widest">
        CAREER PATH
      </div>
      <h2 class="text-h1 font-bold text-[var(--color-text-primary)] tracking-tight">
        Experience
      </h2>
      <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
        IT infrastructure internships, telemedicine system support, and web administration roles.
      </p>
    </div>

    <!-- Main Frontend / Web Roles Timeline -->
    <div class="space-y-8 max-w-3xl">
      {primaryExperiences.map(item => (
        <ExperienceItem item={item} />
      ))}
    </div>

    <!-- Secondary Prior Work Experience -->
    {secondaryExperiences.length > 0 && (
      <div class="space-y-6 max-w-3xl pt-6 border-t border-[var(--color-border)]/60">
        <h3 class="text-label font-mono text-[var(--color-text-secondary)] tracking-wider uppercase">
          Earlier Experience &amp; Internships
        </h3>
        <div class="space-y-6">
          {secondaryExperiences.map(item => (
            <ExperienceItem item={item} />
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- About Section (Biography, Education & Academic Achievements) -->
  <About />

  <!-- Contact & Collaboration Section -->
  <Contact />
</Layout>

<script>
  // Client-side controller for interactive technology filtering
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.project-filter-btn');
    const projectCards = document.querySelectorAll<HTMLElement>('[data-project-card]');
    const statusEl = document.getElementById('filter-status');
    const emptyEl = document.getElementById('no-projects-msg');

    if (!filterBtns.length || !projectCards.length) return;

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';

        // Update button visual states
        filterBtns.forEach(b => {
          const isActive = b === btn;
          if (isActive) {
            b.classList.remove('border-[var(--color-border)]', 'bg-[var(--color-surface)]', 'text-[var(--color-text-secondary)]');
            b.classList.add('border-[var(--color-accent)]', 'bg-[var(--color-accent)]', 'text-white', 'shadow-xs');
            b.setAttribute('aria-selected', 'true');
          } else {
            b.classList.remove('border-[var(--color-accent)]', 'bg-[var(--color-accent)]', 'text-white', 'shadow-xs');
            b.classList.add('border-[var(--color-border)]', 'bg-[var(--color-surface)]', 'text-[var(--color-text-secondary)]');
            b.setAttribute('aria-selected', 'false');
          }
        });

        // Filter project cards with smooth entry transition
        let visibleCount = 0;
        projectCards.forEach(card => {
          const techs = (card.dataset.technologies || '').toLowerCase();
          let matches = false;

          if (filter === 'all') {
            matches = true;
          } else if (filter === 'react') {
            matches = techs.includes('react');
          } else if (filter === 'php') {
            matches = techs.includes('php') || techs.includes('mysql');
          } else if (filter === 'api') {
            matches = techs.includes('api');
          } else if (filter === 'bootstrap') {
            matches = techs.includes('bootstrap');
          }

          if (matches) {
            card.classList.remove('hidden');
            card.style.opacity = '0';
            card.style.transform = 'translateY(8px)';
            requestAnimationFrame(() => {
              card.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            });
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Update dynamic counter text
        if (statusEl) {
          const filterName = btn.querySelector('span')?.textContent || filter;
          if (filter === 'all') {
            statusEl.innerHTML = `Showing all <span class="font-bold text-[var(--color-text-primary)]">${visibleCount}</span> projects`;
          } else {
            statusEl.innerHTML = `Showing <span class="font-bold text-[var(--color-text-primary)]">${visibleCount}</span> projects matching <span class="text-[var(--color-accent-text)] font-semibold">${filterName}</span>`;
          }
        }

        // Toggle empty state if no results match
        if (emptyEl) {
          emptyEl.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  });
</script>
