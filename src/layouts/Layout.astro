---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const SITE_URL = Astro.site ? Astro.site.origin : "https://enitan-ajayi.dev";

const { 
  title = "Ajayi Enitan Fiyinfoluwa | Frontend Developer & Web Developer", 
  description = "Ajayi Enitan Fiyinfoluwa is a Frontend Developer and Web Developer based in Lagos, Nigeria specializing in responsive web applications, React, PHP backends, and modern UI engineering.",
  ogImage = `${SITE_URL}/portrait.jpg`,
  ogType = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
const GITHUB_URL = "https://github.com/ajayienitan";
const LINKEDIN_URL = "https://www.linkedin.com/in/enitan-ajayi-7830ab348?trk=contact-info";
const RESUME_PATH = "/resume.pdf";

const isHomepage = Astro.url.pathname === "/";

// Factual JSON-LD structured data for Person and ProfilePage
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ajayi Enitan Fiyinfoluwa",
  "jobTitle": "Frontend Developer & Web Developer",
  "url": SITE_URL,
  "sameAs": [
    GITHUB_URL,
    LINKEDIN_URL
  ],
  "alumniOf": {
    "@type": "EducationalOrganization",
    "name": "Caleb University Imota, Lagos",
    "description": "BSc (Hons) Computer Science"
  },
  "knowsAbout": [
    "Frontend Engineering",
    "Web Development",
    "HTML5 & CSS3",
    "JavaScript ES6+",
    "React",
    "Bootstrap 5",
    "PHP",
    "MySQL",
    "RESTful APIs",
    "Canva UI/UX Prototyping",
    "Responsive Design"
  ]
};

const profilePageJsonLd = isHomepage ? {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "dateCreated": "2026-01-01T00:00:00Z",
  "mainEntity": personJsonLd
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f1d38" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ajayi Enitan Fiyinfoluwa" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Ajayi Enitan Fiyinfoluwa Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    {profilePageJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(profilePageJsonLd)} />
    )}

    <!-- Anti-FOUT theme script -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col justify-between bg-[var(--color-background)] text-[var(--color-text-primary)] transition-colors duration-150">
    <a href="#main-content" class="skip-to-content">
      Skip to main content
    </a>

    <!-- Sticky Header Navigation -->
    <header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-background)]/90 backdrop-blur-md">
      <Navbar />
    </header>

    <!-- Main Content Container -->
    <main id="main-content" class="container-custom flex-grow py-8">
      <slot />
    </main>

    <!-- Minimal Semantic Footer -->
    <footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)] py-8 text-meta text-[var(--color-text-secondary)]">
      <div class="container-custom flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>&copy; {new Date().getFullYear()} Ajayi Enitan Fiyinfoluwa. All rights reserved.</p>
        <div class="flex items-center gap-5">
          <a href={RESUME_PATH} target="_blank" download="Ajayi_Enitan_Fiyinfoluwa_Resume.pdf" class="hover:text-[var(--color-accent-text)] transition-colors">
            Resume ↗
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-primary)] transition-colors">
            GitHub ↗
          </a>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-primary)] transition-colors">
            LinkedIn ↗
          </a>
        </div>
      </div>
    </footer>
    <!-- Top Scroll / Reading Progress Bar (Item #6 Improvement) -->
    <div 
      id="scroll-progress-bar" 
      class="fixed top-0 left-0 h-[2.5px] w-0 bg-[var(--color-accent)] z-[100] transition-[width] duration-75 ease-out shadow-[0_0_8px_var(--color-accent)] pointer-events-none"
      aria-hidden="true"
    ></div>

    <!-- Floating Back to Top Button (Item #6 Improvement) -->
    <button
      id="back-to-top-btn"
      type="button"
      class="fixed bottom-6 right-6 z-40 inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]/90 backdrop-blur-md p-2.5 text-[var(--color-text-primary)] shadow-md transition-all duration-300 hover:border-[var(--color-accent)] hover:text-[var(--color-accent-text)] hover:-translate-y-1 hover:shadow-lg focus-visible:outline-none opacity-0 translate-y-3 pointer-events-none cursor-pointer"
      aria-label="Scroll back to top of page"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <!-- Global Animated Floating Toast Notification (Item #3 Improvement) -->
    <div 
      id="global-toast" 
      class="fixed bottom-20 right-6 sm:bottom-8 sm:right-20 z-50 pointer-events-none opacity-0 translate-y-3 transition-all duration-300 max-w-sm w-full sm:w-auto"
      role="status"
      aria-live="polite"
    >
      <div class="flex items-center gap-3 rounded-[var(--radius-md)] border border-[var(--color-accent)] bg-[var(--color-surface)]/95 backdrop-blur-md px-4 py-3 shadow-xl ring-1 ring-black/5 dark:ring-white/10">
        <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-bold text-sm">
          ✓
        </div>
        <div class="space-y-0.5">
          <div id="toast-title" class="text-xs font-bold text-[var(--color-text-primary)] font-mono">
            Copied to clipboard!
          </div>
          <div id="toast-message" class="text-[11px] text-[var(--color-text-secondary)] font-mono truncate max-w-[240px]">
            ajayiiyinoluwa56@gmail.com
          </div>
        </div>
      </div>
    </div>

    <!-- Client-Side Global UI Utilities (Toast, Clipboard & Scroll Controls) -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // --- 1. Clipboard & Toast Controller ---
        let toastTimeout: ReturnType<typeof setTimeout> | null = null;
        const toast = document.getElementById('global-toast');
        const toastTitle = document.getElementById('toast-title');
        const toastMessage = document.getElementById('toast-message');

        const showToast = (title: string, message: string) => {
          if (!toast) return;
          if (toastTitle) toastTitle.textContent = title;
          if (toastMessage) toastMessage.textContent = message;

          toast.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
          toast.classList.add('opacity-100', 'translate-y-0');

          if (toastTimeout) clearTimeout(toastTimeout);
          toastTimeout = setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
          }, 2600);
        };

        // Attach global click handler for [data-copy-text]
        document.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement).closest('[data-copy-text]') as HTMLElement | null;
          if (!target) return;

          const textToCopy = target.dataset.copyText;
          const label = target.dataset.copyLabel || 'Text';
          if (!textToCopy) return;

          navigator.clipboard.writeText(textToCopy).then(() => {
            const btnText = target.querySelector('.btn-text');
            const originalText = btnText ? btnText.textContent : null;
            if (btnText) btnText.textContent = 'Copied! ✓';

            setTimeout(() => {
              if (btnText && originalText) btnText.textContent = originalText;
            }, 2000);

            showToast(`${label} copied!`, textToCopy);
          }).catch(err => {
            console.error('Failed to copy: ', err);
          });
        });

        // --- 2. Top Scroll Progress Bar & Floating Back to Top ---
        const progressBar = document.getElementById('scroll-progress-bar');
        const backToTopBtn = document.getElementById('back-to-top-btn');

        let isTicking = false;

        const updateScrollState = () => {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const scrollPercent = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;

          if (progressBar) {
            progressBar.style.width = `${Math.min(100, Math.max(0, scrollPercent))}%`;
          }

          if (backToTopBtn) {
            const shouldShow = scrollTop > 320;
            backToTopBtn.classList.toggle('opacity-0', !shouldShow);
            backToTopBtn.classList.toggle('translate-y-3', !shouldShow);
            backToTopBtn.classList.toggle('pointer-events-none', !shouldShow);
            backToTopBtn.classList.toggle('opacity-100', shouldShow);
            backToTopBtn.classList.toggle('translate-y-0', shouldShow);
          }

          isTicking = false;
        };

        window.addEventListener('scroll', () => {
          if (!isTicking) {
            requestAnimationFrame(updateScrollState);
            isTicking = true;
          }
        }, { passive: true });

        backToTopBtn?.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });

        // Initial sync on page load
        updateScrollState();
      });
    </script>
  </body>
</html>
