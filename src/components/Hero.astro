---
const CONTACT_EMAIL = "enitan.ajayi.dev@gmail.com";
const RESUME_PATH = "/resume.pdf";
const TECH_STACK = ["HTML5 / CSS3", "JavaScript (ES6+)", "React", "Bootstrap", "PHP", "REST APIs", "Canva"];
---

<section id="hero" class="relative py-12 sm:py-20 lg:py-24 border-b border-[var(--color-border)]">
  <!-- Subtle background grid detail with navy tint -->
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30 pointer-events-none" aria-hidden="true"></div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    <!-- Left Column: Bio & Calls to Action (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Status pill badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] shadow-xs">
        <span class="inline-block h-2 w-2 rounded-full bg-[var(--color-accent)] animate-pulse" aria-hidden="true"></span>
        <span class="text-label text-[var(--color-text-secondary)] tracking-widest font-mono text-xs">
          FRONTEND DEVELOPER · WEB DEVELOPER
        </span>
      </div>

      <!-- Main Headline (H1) -->
      <div class="space-y-2">
        <h1 class="text-display font-extrabold text-[var(--color-text-primary)] tracking-tight leading-[1.1]">
          Hi, I'm <span class="text-[var(--color-accent-text)]">Ajayi Enitan Fiyinfoluwa</span>.
        </h1>
        <p class="text-h2 font-semibold text-[var(--color-text-secondary)]">
          Crafting modern, responsive web experiences &amp; dynamic digital interfaces.
        </p>
      </div>

      <!-- Supporting Narrative -->
      <p class="text-body text-[var(--color-text-secondary)] leading-relaxed max-w-xl">
        Intermediate Frontend &amp; Web Developer with a passion for creative, accessible, and high-performance digital products. Experienced in building responsive React interfaces, integrating RESTful APIs, and implementing full-stack PHP solutions.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a 
          href="#projects" 
          class="inline-flex min-h-[46px] items-center justify-center gap-2 rounded-[var(--radius-sm)] bg-[var(--color-accent)] px-5 font-semibold text-white hover:opacity-90 transition-all shadow-sm focus-visible:outline-none"
        >
          View Projects
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>

        <a 
          href={RESUME_PATH}
          target="_blank"
          download="Ajayi_Enitan_Fiyinfoluwa_Resume.pdf"
          class="inline-flex min-h-[46px] items-center justify-center gap-2 rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface)] px-5 font-semibold text-[var(--color-text-primary)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent-text)] transition-colors focus-visible:outline-none shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-accent-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Download CV / Resume
        </a>

        <a 
          href="#contact"
          class="inline-flex min-h-[46px] items-center justify-center gap-2 rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-transparent px-5 font-semibold text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-text-secondary)] transition-colors focus-visible:outline-none"
        >
          Get in Touch
        </a>
      </div>

      <!-- Quick Availability & Location Meta -->
      <div class="pt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-meta text-[var(--color-text-secondary)] border-t border-[var(--color-border)]/60">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-accent-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>Lagos, Nigeria · Open to Remote</span>
        </div>

        <div class="hidden sm:block text-[var(--color-border)]">•</div>

        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-accent-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-[var(--color-text-primary)] font-medium">Available for hire &amp; projects</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Professional Portrait & Highlights Card (5 Cols) -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end">
      <div class="relative w-full max-w-sm">
        <!-- Ambient decorative navy glow -->
        <div class="absolute -inset-1.5 rounded-2xl bg-gradient-to-tr from-[var(--color-accent)]/20 to-[var(--color-border)]/40 blur-xl opacity-75 pointer-events-none" aria-hidden="true"></div>

        <div class="relative rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-3 shadow-md overflow-hidden">
          <!-- Portrait photo -->
          <div class="relative aspect-square w-full rounded-xl overflow-hidden bg-[var(--color-muted)]">
            <img 
              src="/portrait.jpg" 
              alt="Ajayi Enitan Fiyinfoluwa portrait" 
              class="w-full h-full object-cover object-top transition-transform duration-500 hover:scale-105"
              loading="eager"
            />
            <!-- Gradient bottom overlay for subtle depth -->
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-navy)]/60 via-transparent to-transparent opacity-40 pointer-events-none"></div>
          </div>

          <!-- Bottom Card Identity Info -->
          <div class="pt-3 pb-1 px-1 flex items-center justify-between">
            <div>
              <div class="font-bold text-small text-[var(--color-text-primary)]">
                Ajayi Enitan F.
              </div>
              <div class="text-meta text-[var(--color-accent-text)] font-mono text-xs">
                Frontend Developer
              </div>
            </div>
            <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-background)] text-xs font-mono text-[var(--color-text-secondary)]">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Online</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tech Stack Ticker / Pills at bottom of Hero -->
  <div class="mt-12 pt-6 border-t border-[var(--color-border)]/60 flex flex-wrap items-center gap-2 text-meta text-[var(--color-text-secondary)]">
    <span class="font-semibold text-[var(--color-text-primary)] uppercase tracking-wider text-xs font-mono mr-2">
      Core Toolkit:
    </span>
    {TECH_STACK.map((tech) => (
      <span class="rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-1 text-xs font-mono text-[var(--color-text-primary)] shadow-2xs">
        {tech}
      </span>
    ))}
  </div>
</section>
