---
interface SkillCategory {
  title: string;
  skills: string[];
}

const skillCategories: SkillCategory[] = [
  {
    title: "Front-End Development",
    skills: ["HTML5", "CSS3", "JavaScript (ES6+)", "React.js", "Vue.js", "Bootstrap", "Component Architecture"]
  },
  {
    title: "Backend & APIs",
    skills: ["PHP (Hypertext Preprocessor)", "RESTful API Integration", "MySQL Databases", "JSON", "CRUD Systems"]
  },
  {
    title: "Networking & IT Infrastructure",
    skills: ["Computer Networks (IP, DHCP)", "Routers & Switches", "Hardware & OS Troubleshooting", "Hyper-V Virtualization", "Data Encryption & Backup"]
  },
  {
    title: "Cloud, Tools & Creative",
    skills: ["Web Hosting Administration", "Basic Cloud Infrastructure", "Canva / Graphic Design", "Git & GitHub", "Telemedicine Systems"]
  }
];
---

<section id="skills" class="py-16 sm:py-24 border-b border-[var(--color-border)] space-y-12">
  <div class="max-w-2xl space-y-3">
    <div class="text-label text-[var(--color-accent-text)] font-mono tracking-widest">
      TECHNICAL TOOLKIT
    </div>
    <h2 class="text-h1 font-bold text-[var(--color-text-primary)] tracking-tight">
      Skills &amp; Technologies
    </h2>
    <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
      A comprehensive breakdown of my front-end libraries, backend scripting, IT infrastructure, networking, and creative design tools.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {skillCategories.map(category => (
      <div class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 space-y-4 hover:border-[var(--color-accent)] transition-all duration-150 shadow-2xs">
        <h3 class="text-h3 font-bold text-[var(--color-text-primary)] border-b border-[var(--color-border)]/60 pb-3">
          {category.title}
        </h3>
        <ul class="flex flex-wrap gap-2 text-meta text-[var(--color-text-secondary)] font-mono list-none p-0 m-0">
          {category.skills.map(skill => (
            <li class="rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-background)] px-2.5 py-1 text-xs text-[var(--color-text-primary)] hover:border-[var(--color-accent)] transition-colors">
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
